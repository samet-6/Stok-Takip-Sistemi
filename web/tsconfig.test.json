{
  /* Same compiler rules as the app, with the test globals added. Not listed in tsconfig.json's
     references on purpose: `tsc -b` (and therefore `npm run build`) must not see this project,
     or excluding the tests from the app config would have achieved nothing. */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    /* "node" is here for the tests that read a file to prove two sides agree — the shared
       password vectors in passwordPolicy.test.ts use node:fs/node:path. @types/node is
       already a devDependency; only this list was missing it. */
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["src"],
  "exclude": []
}
